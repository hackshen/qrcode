{
    "name": "Hshen",
    "version": "1.0.0",
    "manifest_version": 3,
    "description": "提升开发效率",
    "icons": {
        "16": "favicon.png",
        "128": "favicon.png"
    },
    "action": {
        "default_title": "Title",
        "default_icon": "favicon.png",
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "content_scripts": [
        {
            "matches": [
                "*://*/*"
            ],
            "js": [
                "inject.js"
            ],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+Shift+S",
                "mac": "Command+Shift+S"
            }
        }
    },
    "permissions": [
        "tabs",
        "storage",
        "cookies",
        "activeTab",
        "contextMenus",
        "downloads",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "webNavigation",
        "scripting"
    ],
    "host_permissions": [
        "*://*/*"
    ],
    "web_accessible_resources": [
        {
            "resources": ["error-monitor.js"],
            "matches": ["<all_urls>"]
        }
    ]
}
