{
    "name": "DevKit Pro - 开发者工具箱",
    "version": "2.0.0",
    "manifest_version": 3,
    "description": "开发者工具集：",
    "icons": {
        "16": "favicon.png",
        "128": "favicon.png"
    },
    "action": {
        "default_title": "DevKit Pro - 开发者工具箱",
        "default_icon": "favicon.png",
        "default_popup": "popup.html"
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "side_panel": {
        "default_path": "sidepanel.html"
    },
    "devtools_page": "devtools.html",
    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "inject.js",
                "auto-login.js",
                "json-viewer.js"
            ],
            "run_at": "document_start"
        }
    ],
    "background": {
        "service_worker": "background.js"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Alt+I",
                "mac": "Ctrl+I"
            }
        }
    },
    "permissions": [
        "tabs",
        "storage",
        "cookies",
        "activeTab",
        "contextMenus",
        "downloads",
        "declarativeNetRequest",
        "declarativeNetRequestWithHostAccess",
        "webNavigation",
        "scripting",
        "sidePanel",
        "debugger",
        "proxy"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}
